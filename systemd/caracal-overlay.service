[Unit]
Description=CARACAL TV Countdown Overlay
Requires=caracal-display.service caracal.service
After=caracal-display.service caracal.service

[Service]
User=caracal
Group=caracal
Environment=HOME=/home/caracal
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/caracal/.Xauthority
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X0 ]; do sleep 1; done'
ExecStart=/usr/bin/python3 /opt/caracal/player/overlay.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
