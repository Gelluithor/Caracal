[Unit]
Description=CARACAL
After=network-online.target
[Service]
User=caracal
Environment=CARACAL_DATA=/var/lib/caracal
WorkingDirectory=/opt/caracal
ExecStart=/opt/caracal/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
