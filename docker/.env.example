# Image and version of the CARACAL node
CARACAL_IMAGE=ghcr.io/gelluithor/caracal-node
CARACAL_VERSION=latest
# uid/gid of the "caracal" user on the host (owner of /var/lib/caracal and of the X display)
CARACAL_UID=1000
CARACAL_GID=1000
# host gids of the "video" and "render" groups (GPU access for Chromium)
CARACAL_VIDEO_GID=44
CARACAL_RENDER_GID=44
# host gid of the "audio" group (notification sounds)
CARACAL_AUDIO_GID=29
